rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Documento privado con todo el progreso del usuario (XP, lecciones, tests, amigos...).
    // Solo el propio usuario autenticado puede leerlo o escribirlo.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Documento público con lo mínimo necesario para la búsqueda de amigos y la clasificación
    // (nombre, XP, código de amigo, avatar). Cualquier usuario autenticado puede leer los perfiles
    // para poder buscar amigos y ver la clasificación, pero solo el dueño puede escribir el suyo.
    match /profiles/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Registro de uso propio de cada usuario, para el panel privado.
    // Solo el dueño del documento puede escribirlo o leerlo; nadie puede
    // borrarlo ni ver el de otra persona. El panel lo lee desde fuera con el
    // Admin SDK, que no pasa por estas reglas — por eso aquí no hace falta
    // (ni conviene) abrir nada más.
    match /_actividad/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    // Todo lo demás, denegado por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
