rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Documento privado con todo el progreso del usuario (XP, lecciones, tests, amigos...).
    // Solo el propio usuario autenticado puede leerlo o escribirlo.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Documento público con lo mínimo necesario para la búsqueda de amigos y la clasificación
    // (nombre, XP, código de amigo, avatar). Cualquier usuario autenticado puede leer los perfiles
    // para poder buscar amigos y ver la clasificación, pero solo el dueño puede escribir el suyo.
    match /profiles/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Todo lo demás, denegado por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
